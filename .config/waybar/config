// WAYBAR CONFIG - MINIMALIST DUAL-MONITOR

[
  // Monitor 1: DP-1 (Primary)
  {
    "output": "HDMI-A-1",
    "layer": "top",
    "position": "top",
    "height": 30, // ИЗМЕНЕНИЕ: Увеличение высоты для устранения сжатия

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["custom/btc", "custom/spx", "custom/fng", "custom/country", "hyprland/language", "custom/ping", "custom/weather", "memory", "cpu", "clock"],

    "hyprland/workspaces": {
      // {icon} is required. Without this literal token waybar never reads
      // format-icons, and {} would print the workspace id instead.
      "format": "{icon}",
      "format-window": "{class} {title}",
      "on-click": "activate",
      "all-outputs": true,
      "persistent-workspaces": {
        "HDMI-A-1": [1, 2, 3],
        "DP-1": [4, 5, 6]
      },
      // Hebrew names of the digits, with niqqud. The keys stay the workspace numbers.
      // No active or default keys. The active workspace must show its own name,
      // not a dot, and the highlight is drawn by CSS on button.active.
      "format-icons": {
        "1": "אֶחָד",
        "2": "שְׁנַיִם",
        "3": "שְׁלֹשָׁה",
        "4": "אַרְבָּעָה",
        "5": "חֲמִשָּׁה",
        "6": "שִׁשָּׁה"
      }
    },

    // Center module: the app name only. The full window title stays in the tooltip.
    "hyprland/window": { "format": "{class}" },

    // MARKET TICKERS
    // Each module prints its own JSON line. The class up or down sets the color.
    // The change is measured since 00:00 UTC. The S&P 500 does not trade then,
    // so it shows the change since the last close.
    // escape: true is needed because waybar reads the text as Pango markup.
    // A bare & in S&P or F&G stops the parse and the label stays empty.
    "custom/btc": {
      "exec": "~/.config/waybar/scripts/market.sh btc",
      "interval": 10,
      "format": "{}",
      "escape": true,
      "return-type": "json"
    },
    "custom/spx": {
      "exec": "~/.config/waybar/scripts/market.sh spx",
      "interval": 60,
      "format": "{}",
      "escape": true,
      "return-type": "json"
    },
    "custom/fng": {
      "exec": "~/.config/waybar/scripts/market.sh fng",
      "interval": 3600,
      "format": "{}",
      "escape": true,
      "return-type": "json"
    },
    "custom/ping": {
      // The number is padded to three places, so the text length never changes.
      // On a failed ping the module prints --- instead of hiding, so the bar keeps its layout.
      "exec": "ping -c 1 -W 1 185.25.182.1 | grep -oP 'time=\\K[0-9.]+' | cut -d '.' -f 1 | awk '{printf \"%3s\", $1} END {if (NR == 0) printf \"---\"}'",
      "format": "{} ms",
      "interval": 1
    },
    // COUNTRY FLAG (5 SECONDS UPDATE)
    "custom/country": {
      "exec": "~/.config/waybar/scripts/get_flag.sh",
      "interval": 5
    },

    // MODULE: Weather (Text + Temp)
    "custom/weather": {
      "exec": "~/.config/waybar/scripts/weather_icon.sh",
      "return-type": "json",
      "interval": 3600, // Update once per hour
      "format": "{text}"
    },

    // Layout names: EN, RU, HE. The key suffix is the xkb short name of the layout
    // (en, ru, he), not its long name.
    "hyprland/language": {
      "format": "{}",
      "format-en": "EN",
      "format-ru": "RU",
      "format-he": "HE",
      "tooltip-format": "{long}"
    },

    // ИСПРАВЛЕНИЕ: Формат для MEMORY: RAM удален, установлен формат GB
    "memory": {
        "format": "{used:0.1f}GB/{total:0.1f}GB",
        "tooltip": true
    },
    // ИСПРАВЛЕНИЕ: Формат для CPU: убран спецификатор форматирования, вызывавший ошибку
    "cpu": {
        "format": "CPU {usage}%",
        "tooltip": true
    },

    "clock": {
      "format": "{:%H:%M}"
    }
  },

  // Monitor 2: HDMI-A-1 (Secondary)
  {
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 30, // ИЗМЕНЕНИЕ: Увеличение высоты для устранения сжатия
    "modules-left": ["hyprland/workspaces"],
    "modules-center": [
      "hyprland/window"
    ],
    "modules-right": [
      "memory", // Память на месте
      "cpu",
      "clock"
    ],
    "hyprland/window": { "format": "{class}" },
    "hyprland/workspaces": {
      "format": "{icon}",
      "format-window": "{class} {title}",
      "on-click": "activate",
      "all-outputs": true,
      "persistent-workspaces": {
        "HDMI-A-1": [1, 2, 3],
        "DP-1": [4, 5, 6]
      },
      "format-icons": {
        "1": "אֶחָד",
        "2": "שְׁנַיִם",
        "3": "שְׁלֹשָׁה",
        "4": "אַרְבָּעָה",
        "5": "חֲמִשָּׁה",
        "6": "שִׁשָּׁה"
      }
    }
  }
]
